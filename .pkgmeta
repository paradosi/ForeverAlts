package-as: ForeverAlts

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# media/fonts ships, licence files included: the OFL requires them alongside the fonts
ignore:
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - LICENSE
  - .github
  - .gitignore
  - tests
  - tools
  - media/art
  - media/screenshots
